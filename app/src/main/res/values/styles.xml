<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Versus.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/versus_button_tint</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">@color/versus_ripple</item>
    </style>

    <style name="Widget.Versus.Button.Secondary" parent="Widget.Versus.Button">
        <item name="backgroundTint">@color/versus_accent_surface</item>
        <item name="android:textColor">@color/versus_text</item>
    </style>

    <style name="Widget.Versus.PlatformButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/versus_button_background</item>
        <item name="android:backgroundTint">@color/versus_button_tint</item>
        <item name="android:textColor">@color/versus_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Versus.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/versus_input_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/versus_text</item>
        <item name="android:textColorHint">@color/versus_text_secondary</item>
    </style>
</resources>
