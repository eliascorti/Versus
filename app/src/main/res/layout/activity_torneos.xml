<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    tools:context=".TorneosActivity">

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/layoutEncabezado"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgVolver"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/volver"
            app:srcCompat="@drawable/left_arrow" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/nuevo_torneo"
            android:textColor="#17212F"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Contenido desplazable -->
    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutEncabezado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Nombre del torneo -->
            <TextView
                android:id="@+id/txtNombreTorneo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nombre_torneo"
                android:textColor="#17212F"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNombreTorneo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:hint="@string/hint_nombre_torneo"
                android:inputType="text|textCapSentences"
                android:singleLine="true"
                android:textColor="#17212F"
                android:textColorHint="#929BA6"
                android:textSize="16sp" />

            <!-- Encabezado de participantes -->
            <LinearLayout
                android:id="@+id/layoutEncabezadoParticipantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtParticipantes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/participantes"
                    android:textColor="#17212F"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtContador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contador_inicial"
                    android:textColor="#788697"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Agregar participante -->
            <LinearLayout
                android:id="@+id/layoutAgregarParticipante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtParticipante"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_participante"
                    android:inputType="text|textCapWords"
                    android:singleLine="true"
                    android:textColor="#17212F"
                    android:textColorHint="#929BA6"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnAgregar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="#DCEBFC"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="@string/agregar_simbolo"
                    android:textAllCaps="false"
                    android:textColor="#17212F"
                    android:textSize="24sp" />

            </LinearLayout>

            <!-- Lista dinámica -->
            <LinearLayout
                android:id="@+id/layoutListaParticipantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="4dp" />

            <!-- Generar torneo -->
            <Button
                android:id="@+id/btnGenerarTorneo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#5D93D0"
                android:text="@string/crear_generar_torneo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
