<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/versus_background"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="24dp">
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="260dp"
                android:layout_height="104dp"
                android:layout_marginTop="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="32dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/versus_logo" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTorneos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                app:cardBackgroundColor="@color/versus_surface"
                app:cardCornerRadius="0dp"
                android:foreground="?attr/selectableItemBackground"
                android:focusable="true"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/layoutContenidoTorneos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="156dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/imgTrofeo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:scaleType="fitCenter"
                        app:tint="@color/versus_primary"
                        app:srcCompat="@drawable/ic_trofeo" />

                    <TextView
                        android:id="@+id/txtTorneos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inicio_torneos"
                        android:textColor="@color/versus_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDescripcionTorneos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/inicio_descripcion_torneos"
                        android:textAlignment="center"
                        android:textColor="@color/versus_text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardEquipos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/versus_surface"
                app:cardCornerRadius="0dp"
                android:foreground="?attr/selectableItemBackground"
                android:focusable="true"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/layoutContenidoEquipos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="156dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/imgEquipos"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:scaleType="fitCenter"
                        app:tint="@color/versus_primary"
                        app:srcCompat="@drawable/ic_usuarios" />

                    <TextView
                        android:id="@+id/txtEquipos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inicio_equipos"
                        android:textColor="@color/versus_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDescripcionEquipos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/inicio_descripcion_equipos"
                        android:textAlignment="center"
                        android:textColor="@color/versus_text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
